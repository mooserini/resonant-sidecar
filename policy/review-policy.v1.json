{
  "schemaVersion": 1,
  "runtimeContract": {
    "packageType": "module",
    "nodeEngine": ">=22",
    "excludedResolutionFields": ["main", "imports", "exports"]
  },
  "approvedCapabilities": {
    "chromePermissions": [
      "nativeMessaging",
      "sidePanel",
      "storage"
    ],
    "hostPermissions": [],
    "listeners": [],
    "lifecycleScripts": []
  },
  "approvedBundlePaths": [
    "extension/manifest.json",
    "extension/service-worker.js",
    "extension/sidepanel-controller.js",
    "extension/sidepanel.css",
    "extension/sidepanel.html",
    "extension/sidepanel.js",
    "native-host/app-server-client.js",
    "native-host/host.js",
    "native-host/native-framing.js",
    "native-host/sidecar-protocol.js",
    "package.json",
    "scripts/install-macos.js"
  ],
  "trustedTestCommands": [
    [
      "node",
      "--check",
      "native-host/app-server-client.js"
    ],
    [
      "node",
      "--check",
      "native-host/host.js"
    ],
    [
      "node",
      "--check",
      "native-host/native-framing.js"
    ],
    [
      "node",
      "--check",
      "native-host/sidecar-protocol.js"
    ],
    [
      "node",
      "--check",
      "extension/service-worker.js"
    ],
    ["node", "--check", "extension/sidepanel-controller.js"],
    ["node", "--check", "extension/sidepanel.js"],
    ["node", "--check", "scripts/install-macos.js"],
    ["node", "--experimental-vm-modules", "review/trusted-harness.js", "unit"],
    ["node", "--experimental-vm-modules", "review/trusted-harness.js", "protocol"],
    ["node", "--experimental-vm-modules", "review/trusted-harness.js", "continuity"],
    ["node", "--experimental-vm-modules", "review/trusted-harness.js", "interruption"],
    ["node", "--experimental-vm-modules", "review/trusted-harness.js", "negative-policy"]
  ],
  "receiptFields": [
    "receiptId",
    "reviewId",
    "eventType",
    "outcome",
    "previousReceiptHash",
    "projectEvidenceHash",
    "osEvidenceHash",
    "policySnapshotHash",
    "verifierIdentities",
    "activeBundleDigest",
    "candidateBundleDigest",
    "humanDecisionRef",
    "createdAt"
  ],
  "stateTransitions": {
    "available": [
      "staged",
      "custody-broken"
    ],
    "staged": [
      "deterministic-review",
      "review-failed",
      "custody-broken"
    ],
    "deterministic-review": [
      "codex-review",
      "review-failed",
      "custody-broken"
    ],
    "codex-review": [
      "eligible",
      "review-failed",
      "custody-broken"
    ],
    "eligible": [
      "human-accepted",
      "rejected",
      "custody-broken"
    ],
    "human-accepted": [
      "activating",
      "custody-broken"
    ],
    "activating": [
      "activated",
      "activation-failed",
      "custody-broken"
    ],
    "activation-failed": [
      "rolling-back",
      "custody-broken"
    ],
    "rolling-back": [
      "rolled-back",
      "custody-broken"
    ],
    "activated": [],
    "review-failed": [],
    "rejected": [],
    "rolled-back": [],
    "custody-broken": []
  },
  "codexAttestationSchema": "policy/codex-attestation.v1.schema.json"
}
