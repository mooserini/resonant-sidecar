{
  "manifest_version": 3,
  "name": "Resonant Sidecar",
  "version": "0.1.0",
  "description": "A local, conversation-only side panel for one Codex CLI session.",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "sidePanel",
    "storage"
  ],
  "action": {},
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
